<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#0E1E42"
                android:endColor="#04081A"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerX="0.82"
                android:centerY="0.12"
                android:endColor="#001E5BFF"
                android:gradientRadius="62dp"
                android:startColor="#5A1E5BFF"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerX="0.12"
                android:centerY="0.88"
                android:endColor="#007C5CFF"
                android:gradientRadius="55dp"
                android:startColor="#4D7C5CFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
