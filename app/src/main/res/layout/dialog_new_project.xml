<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <EditText
        android:id="@+id/nameInput"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_input"
        android:hint="@string/project_name"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="?attr/auroraText"
        android:textColorHint="?attr/auroraTextDim"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/descriptionInput"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:gravity="top|start"
        android:hint="@string/project_desc"
        android:inputType="textCapSentences|textMultiLine"
        android:padding="16dp"
        android:textColor="?attr/auroraText"
        android:textColorHint="?attr/auroraTextDim"
        android:textSize="15sp" />

    <TextView
        style="@style/Text.Aurora.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/project_icon" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/emojiRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        style="@style/Text.Aurora.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/project_accent" />

    <LinearLayout
        android:id="@+id/accentRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal" />
</LinearLayout>
