<?xml version="1.0" encoding="utf-8"?>
<com.aurora.workspace.widgets.GlassCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="196dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:glassCorner="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/emoji"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:text="\u2728"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/name"
            style="@style/Text.Aurora.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/projects_title" />

        <TextView
            android:id="@+id/description"
            style="@style/Text.Aurora.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:minLines="2"
            android:text="@string/projects_sub"
            android:textSize="12sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            app:indicatorColor="?attr/auroraAccent"
            app:trackColor="?attr/auroraStroke"
            app:trackCornerRadius="3dp"
            app:trackThickness="5dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tasks"
                style="@style/Text.Aurora.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/project_tasks"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/progressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plexarabic_medium"
                android:text="@string/percent_format"
                android:textColor="?attr/auroraAccent"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</com.aurora.workspace.widgets.GlassCard>
