<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <EditText
        android:id="@+id/input"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_input"
        android:hint="@string/task_name_hint"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="?attr/auroraText"
        android:textColorHint="?attr/auroraTextDim"
        android:textSize="15sp" />

    <TextView
        style="@style/Text.Aurora.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/priority_label" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipPriorityNone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp"
            android:text="@string/priority_none"
            android:textColor="?attr/auroraTextDim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipPriorityLow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp"
            android:text="@string/priority_low"
            android:textColor="?attr/auroraTextDim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipPriorityMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp"
            android:text="@string/priority_medium"
            android:textColor="?attr/auroraTextDim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipPriorityHigh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp"
            android:text="@string/priority_high"
            android:textColor="?attr/auroraTextDim"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/tagInput"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:hint="@string/tag_hint"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="?attr/auroraText"
        android:textColorHint="?attr/auroraTextDim"
        android:textSize="14sp" />
</LinearLayout>
